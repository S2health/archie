specialize
	s2-EHR-Info_node.anatomical_location_classical.v1

definition
	Info_node[id1.1.1] matches {	-- Anatomical location
		value matches {
			Coded_text[id10] matches {
				term matches {
					Terminology_term[id110] matches {
						concept matches {[ac4.0.1]}		-- Coded body location
					}
				}
			}
		}
		items matches {
			use_archetype Info_node[id55, s2-EHR-Info_node.media_file.v2] occurrences matches {0} 
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1.1"] = <
				text = <"Medication supply amount">
				description = <"Medication supply amount">
			>
			["ac4.0.1"] = <
				text = <"Medication admin site">
				description = <"Medication admin site">
			>
		>
	>
	term_bindings = <
		["s2"] = <
			["ac4.0.1"] = <http://s2health.org/id/s2.MedicationAdministrationSite>
		>
	>

