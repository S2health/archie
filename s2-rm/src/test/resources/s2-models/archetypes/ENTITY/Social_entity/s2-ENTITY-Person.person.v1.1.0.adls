archetype (adl_version=2.1.0; rm_release=0.8.7; uid=3f7fbe34-4e64-4c02-8d1a-402f7b0f57ce)
	s2-ENTITY-Person.person.v1.2.0

language
	original_language = <[iso_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"S2 Health">
		["organisation"] = <"S2 Health <http://www.S2Health.org>">
		["email"] = <"models@s2health.org">
		["date"] = <"2024-07-26">
	>
	custodian_namespace = <"org.s2health">
	custodian_organisation = <"S2 Health <http://s2health.org>">
	copyright = <"Copyright (c) 2023 S2 Health">
	licence = <"Creative Commons CC-BY 4.0 unported <http://creativecommons.org/>">
	ip_acknowledgements = <
		["original_author"] = <"Thomas Beale <thomas.beale@graphitehealth.io">
		["loinc"] = <"This content from LOINC® is copyright © 1995 Regenstrief Institute, Inc. and the LOINC Committee, and available at no cost under the license at <http://loinc.org/terms-of-use>">
		["snomed"] = <"Content from SNOMED CT® is copyright © 2007 IHTSDO <ihtsdo.org>">
		["openehr"] = <"Converted from openEHR archetype openEHR-EHR-CLUSTER.person.v1.0.2">
	>
	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"To record details about a person.">
			use = <"Use to record details of a person, independent of specific relationships with organizations or other persons. The `identifiers` property may be used to record external identifiers used for the person, such as social security number, drivers license id and so on. These are recorded according to privacy legislation and need.">
			keywords = <"person", "demographics">
		>
	>

definition
	Person[id1] matches {	-- Person
		comms_addresses matches {
			use_archetype Info_node[id2, s2-ENTITY-Info_node.comms_address.v1] 
		}
		location_addresses matches {
			use_archetype Info_node[id6, s2-ENTITY-Info_node.location_address.v1] 
		}
		identities matches {
			use_archetype Info_node[id7, s2-ENTITY-Info_node.person_name_and_use.v1] 
		}
		languages matches {
			use_archetype Info_node[id4, s2-EHR-Info_node.language.v2] 
		}
		other_details matches {
			Info_node[id8] occurrences matches {0..1} matches {	-- Date of birth
				value matches {
					Date_value[id108] 
				}
			}
			Info_node[id9] occurrences matches {0..1} matches {	-- Place of birth
				value matches {
					Plain_text[id109] 
				}
			}
			Info_node[id12] occurrences matches {0..1} matches {	-- Sex
				value matches {
					Coded_text[id112] matches {
						term matches {
							Terminology_term[id1112] matches {
								concept matches {[ac2]}		-- Biological sex
							}
						}
					}
				}
			}
			Info_node[id13] occurrences matches {0..1} matches {	-- Date of decease
				value matches {
					Date_value[id113] 
				}
			}
			Info_node[id14] occurrences matches {0..1} matches {	-- Deceased
				value matches {
					Boolean_value[id114] 
				}
			}
			Info_node[id15] occurrences matches {0..1} matches {	-- Administrative gender
				value matches {
					Coded_text[id115] matches {
						term matches {
							Terminology_term[id1115] matches {
								concept matches {[ac5]}		-- Adminstrative gender
							}
						}
					}
				}
			}
			Info_node[id16] occurrences matches {0..1} matches {	-- Marital status
				value matches {
					Coded_text[id116] matches {
						term matches {
							Terminology_term[id1116] matches {
								concept matches {[ac6]}		-- Marital status
							}
						}
					}
				}
			}
			Info_node[id10] occurrences matches {0..1} matches {	-- Photo
				value matches {
					Multimedia[id110] 
				}
			}
			Info_node[id20] occurrences matches {0..1} matches {	-- Race
				value matches {
					Coded_text[id120] matches {
						term matches {
							Terminology_term[id1020] matches {
								concept matches {[ac7]}		-- Race
							}
						}
					}
				}
			}
			Info_node[id21] occurrences matches {0..1} matches {	-- Ethnicity
				value matches {
					Coded_text[id121] matches {
						term matches {
							Terminology_term[id1021] matches {
								concept matches {[ac8]}		-- Ethnicity
							}
						}
					}
				}
			}
			Info_node[id22] occurrences matches {0..1} matches {	-- Organ donor
				value matches {
					Coded_text[id122] matches {
						term matches {
							Terminology_term[id1022] matches {
								concept matches {[ac9]}
							}
						}
					}
				}
			}
			Info_node[id11] occurrences matches {0..1} matches {	-- Comment
				value matches {
					Plain_text[id111] 
				}
			}
			use_archetype Info_node[id40, s2-ENTITY-Info_node.person_other_demographics.v0] occurrences matches {0..1} 
		}
		identifiers matches {
			Info_node[id30] matches {	-- External id
				value matches {
					Plain_text[id1030] occurrences matches {1} 
				}
				items matches {
					Info_node[id130] occurrences matches {1} matches {	-- Idenitifier
						value matches {
							Rwe_id_ref[id1130] occurrences matches {1} 
						}
					}
					Info_node[id131] occurrences matches {1} matches {
						value matches {
							Rwe_id_ref[id1131] occurrences matches {1} 
						}
					}
				}
			}
		}
	}

