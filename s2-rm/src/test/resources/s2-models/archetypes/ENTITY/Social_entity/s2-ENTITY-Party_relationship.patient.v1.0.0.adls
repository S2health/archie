archetype (adl_version=2.1.0; rm_release=0.8.7; uid=9f7dbe3a-4e64-4c02-8d1a-402f7b0f57ce)
	s2-ENTITY-Party_relationship.patient.v1.1.1

language
	original_language = <[ISO_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"S2 Health">
		["organisation"] = <"S2 Health <http://www.S2Health.org>">
		["email"] = <"models@s2health.org">
		["date"] = <"2024-07-26">
	>
	custodian_namespace = <"org.s2health">
	custodian_organisation = <"S2 Health <http://s2health.org>">
	copyright = <"Copyright (c) 2023 S2 Health">
	licence = <"Creative Commons CC-BY 4.0 unported <http://creativecommons.org/>">
	ip_acknowledgements = <
		["loinc"] = <"This content from LOINC® is copyright © 1995 Regenstrief Institute, Inc. and the LOINC Committee, and available at no cost under the license at <http://loinc.org/terms-of-use>">
		["snomed"] = <"Content from SNOMED CT® is copyright © 2007 IHTSDO <ihtsdo.org>">
		["openehr"] = <"Converted from openEHR archetype openEHR-EHR-CLUSTER.person.v1.0.2">
	>
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record details about a patient.">
			use = <"Use to record details of a patient.">
			keywords = <"patient", "demographics">
		>
	>

definition
	Party_relationship[id1] matches {	-- Patient
		other_details matches {
			Info_node[id6] occurrences matches {0..1} matches {	-- Language capabilities
				items matches {
					use_archetype Info_node[id7, s2-EHR-Info_node.language.v2] 
				}
			}
			use_archetype Info_node[id3, s2-ENTITY-Info_node.patient_contact.v1] 
			Info_node[id4] occurrences matches {0..1} matches {	-- Multiple birth indicator
				value matches {
					Boolean_value[id104] 
				}
			}
			Info_node[id5] occurrences matches {0..1} matches {	-- Multiple birth order number
				value matches {
					Count[id105] matches {
						magnitude matches {|>0|}
					}
				}
			}
			Info_node[id8] occurrences matches {0..1} matches {	-- Care-relevant disabilities
				items matches {
					Info_node[id9] occurrences matches {0..1} matches {	-- Disability
						value matches {
							Coded_text[id109] matches {
								term matches {
									Terminology_term[id1009] matches {
										concept matches {[ac1]}		-- Disability
									}
								}
							}
						}
						items matches {
							Info_node[id10] occurrences matches {0..1} matches {	-- Comment
								value matches {
									Plain_text[id110] 
								}
							}
						}
					}
				}
			}
			Info_node[id2] occurrences matches {0..1} matches {	-- Insurance details
				items matches {
					Info_node[id22] occurrences matches {0..1} matches {	-- Insurance organization
						value matches {
							Plain_text[id122] 
						}
					}
					Info_node[id23] occurrences matches {0..1} matches {	-- Insurance group id
						value matches {
							Plain_text[id123] 
						}
					}
					Info_node[id24] occurrences matches {0..1} matches {	-- Insurance member id
						value matches {
							Plain_text[id124] 
						}
					}
				}
			}
			Info_node[id30] matches {	-- External identifier description
				value matches {
					Plain_text[id1030] occurrences matches {1} 
				}
				items matches {
					Info_node[id130] occurrences matches {1} matches {	-- Identifier
						value matches {
							Rwe_id_ref[id1130] occurrences matches {1} 
						}
					}
					Info_node[id131] occurrences matches {1} matches {	-- Comment
						value matches {
							Rwe_id_ref[id1131] occurrences matches {1} 
						}
					}
				}
			}
		}
	}

