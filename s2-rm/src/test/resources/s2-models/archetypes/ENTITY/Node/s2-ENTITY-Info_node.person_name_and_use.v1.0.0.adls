	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"To record details about the name of an individual and how it is used.">
		>
	>

definition
	Info_node[id1] matches {	-- Name of a person and use
		value matches {
			Plain_text[id30] 
		}
		items matches {
			Info_node[id21] matches {	-- Usage
				value matches {
					Coded_text[id123] matches {
						term matches {
							Terminology_term[id1123] matches {
								concept matches {[ac1]}		-- Purpose of name
							}
						}
					}
				}
			}
			use_archetype Info_node[id20, s2-ENTITY-Info_node.person_structured_name.v1] occurrences matches {0..1} 
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1"] = <
				text = <"Name of a person and use">
				description = <"Discrete components of an individual's name plus valid usage.">
			>
			["id20"] = <
				text = <"Structured name">
				description = <"Elements of name">
			>
			["id21"] = <
				text = <"Usage">
				description = <"Valid usage of this name">
			>
			["ac1"] = <
				text = <"Purpose of name">
				description = <"Purpose of name, i.e. social context for use">
			>
		>
	>
	term_bindings = <
		["loinc"] = <
			["id1"] = <http://loinc.org/97845-2>
			["id20"] = <http://loinc.org/6afbe6fb-f59d-ef11-8872-6045bdc71c8b>
			["id21"] = <http://loinc.org/97846-0>
		>
		["s2"] = <
			["ac1"] = <http://s2health.org/id/s2.PersonNameUse>
		>
	>

