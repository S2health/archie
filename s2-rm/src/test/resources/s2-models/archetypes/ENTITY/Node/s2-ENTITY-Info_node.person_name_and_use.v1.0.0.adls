	s2-ENTITY-Info_node.person_name_and_use.v1.0.0

language
	original_language = <[iso_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"S2 Health - Knowledge Engineering">
