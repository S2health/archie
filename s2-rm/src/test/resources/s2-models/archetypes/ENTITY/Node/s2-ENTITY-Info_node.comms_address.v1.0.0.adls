	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"To record details about a specified type of electronic communication as it is known or understood in the course of clinical documentation.">
			keywords = <"telephone", "phone", "mobile", "email", "fax", "pager", "chat", "social media", "asynchronous", "communication", "SoMe">
		>
	>

definition
	Info_node[id1] matches {	-- Communications address, including postal
		items matches {
			Info_node[id10] matches {	-- Address string
				value matches {
					Plain_text[id110] matches {
						text matches {/([0-9+()]+|((([A-Za-z]{3,9}:(?:\/\/)?)(?:[-;:&=\+\$,\w]+@)?[A-Za-z0-9.-]+|(?:www.|[-;:&=\+\$,\w]+@)[A-Za-z0-9.-]+)((?:\/[\+~%\/.\w-_]*)?\??(?:[-\+=&;%@.\w_]*)#?(?:[\w]*))?))/}
					}
				}
			}
			Info_node[id11] matches {	-- Communications platform
				value matches {
					Coded_text[id111] matches {
						term matches {
							Terminology_term[id1111] matches {
								concept matches {[ac3]}		-- Address platform, e.g. whatsapp, instagram etc
							}
						}
					}
				}
			}
			Info_node[id12] matches {	-- Communications purpose
				value matches {
					Coded_text[id112] matches {
						term matches {
							Terminology_term[id1112] matches {
								concept matches {[ac4]}		-- Purpose, e.g. business, private
							}
						}
					}
				}
			}
			Info_node[id13] matches {	-- Communication technology, e.g. phone, email etc
				value matches {
					Coded_text[id113] matches {
						term matches {
							Terminology_term[id1113] matches {
								concept matches {[ac1]}		-- Communication technology, e.g. email, phone (landline), phone (mobile), chat
							}
						}
					}
				}
			}
		}
	}

