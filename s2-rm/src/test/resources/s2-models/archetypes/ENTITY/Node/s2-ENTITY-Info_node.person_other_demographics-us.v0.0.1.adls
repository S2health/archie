definition
	Info_node[id1.1] matches {	-- US-specific extended demographics
		items matches {
			Info_node[id0.2] occurrences matches {0..1} matches {	-- mothers_maiden_name
				value matches {
					Plain_text[id0.7] 
				}
			}
			Info_node[id0.3] occurrences matches {0..1} matches {	-- Nationalities
				items matches {
					Info_node[id0.8] matches {	-- Nationality
						value matches {
							Coded_text[id0.9]  matches {
								term matches {
									Terminology_term[id0.1005] matches {
										concept matches {[ac0.3]}
									}
								}
							}
						}
					}
				}
			}
			Info_node[id0.5] occurrences matches {0..1} matches {	-- Religion
				value matches {
					Coded_text[id0.105] matches {
						term matches {
							Terminology_term[id0.1005] matches {
								concept matches {[ac0.1]}
							}
						}
					}
				}
			}
			Info_node[id0.6] occurrences matches {0..1} matches {	-- Military service status
				value matches {
					Coded_text[id0.106] matches {
						term matches {
							Terminology_term[id0.1006] matches {
								concept matches {[ac0.2]}
							}
						}
					}
				}
			}
		}
	}

