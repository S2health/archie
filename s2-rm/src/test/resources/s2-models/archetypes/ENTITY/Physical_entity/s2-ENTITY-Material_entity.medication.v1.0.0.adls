	>
	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"To record an instance of medication, i.e. particular package, lot or other inventory unit.">
			use = <"Use to record inventory of medication.">
			keywords = <"medication", "inventory", "substance", "drug", "therapeutic", "formulation", "medicine">
		>
	>

definition
	Material_entity[id1] matches {	-- Medication description
		lot_information matches {
			Info_node[id2] matches {	-- Batch ID
				value matches {
					Rwe_id_ref[id100] 
				}
			}
			Info_node[id4] occurrences matches {0..1} matches {	-- Expiry
				value matches {
					Date_time_value[id169] 
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1"] = <
				text = <"Medication inventory">
				description = <"Description of a medication inventory item.">
			>
			["id2"] = <
				text = <"Batch ID">
				description = <"The identifier assigned to the production batch by the manufacturer during production.">
			>
			["id4"] = <
				text = <"Expiry">
				description = <"The expiry date and/or time of the medication or medication component, as given by the manufacturer or individual preparing the mixture.">
			>
		>
	>
	term_bindings = <
		["loinc"] = <
			["id4"] = <http://loinc.org/74066-2>
			["id1"] = <http://loinc.org/74078-7>
			["id2"] = <http://loinc.org/74714-7>
		>
	>

