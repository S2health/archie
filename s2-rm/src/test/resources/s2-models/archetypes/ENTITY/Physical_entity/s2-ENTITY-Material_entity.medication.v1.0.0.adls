	s2-ENTITY-Material_entity.medication.v1.0.0

language
	original_language = <[ISO_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"S2 Health">
		["organisation"] = <"S2 Health <http://www.s2Health.org>">
		["email"] = <"models@s2health.org">
		["date"] = <"2024-07-26">
	>
