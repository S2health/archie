	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"To record structured details of a single therapeutic direction for an ordered therapeutic/prescribable item.
            
            Each direction generally applies for a given duration, or fixed number of administrations.">
			use = <"A direction describes one or more sequential therapeutic administration patterns, coupled with an overall direction duration and details of any repetitive pattern of intended administration outside a single day.
            
            For example: '1 tab in the morning, 1 tab at night, for 3 weeks, on Mondays, Wednesdays and Fridays'. This Node allows multiple occurrences to enable representation of a complete set of dosage directions for a single medication order. The Node can be renamed in template or at run-time to represent a specific dosing event such as 'loading dose', 'bolus'.
            
            This archetype will generally be used within an Order archetype. It has been specifically designed for use within a complex Medication order including IV medication, or for fluid orders in the context of transfusion or dialysis.">
			keywords = <"medication", "order", "prescribe", "therapy", "substance", "drug", "therapeutic", "otc", "therapeutic good", "pharmaceutical", "product", "posology", "treatment", "transfusion">
			misuse = <"">
		>
	>
	other_contributors = <"openEHR CKM community">

definition
	Info_node[id1] matches {	-- Therapeutic direction
		items matches {
			Info_node[id58] occurrences matches {0..1} matches {	-- Direction sequence
				value matches {
					Count[id181] matches {
						magnitude matches {|>=1|}
					}
				}
			}
			use_archetype Info_node[id177, s2-EHR-Info_node.dosage.v3] 
			Info_node[id67] occurrences matches {0..1} matches {	-- Direction duration
				value matches {
					Coded_text[id182] matches {
						term matches {
							Terminology_term[id194] matches {
								concept matches {[ac1]}		-- Direction duration (synthesised)
							}
						}
					}
					Duration_value[id183] matches {
						magnitude matches {|>=PT0S|}
					}
					Plain_text[id184] 
					Range<Duration_value>[id185] matches {
						lower matches {
							Duration_value[id186] matches {
								magnitude matches {|>=PT0S|}
							}
						}
						upper matches {
							Duration_value[id187] matches {
								magnitude matches {|>=PT0S|}
							}
						}
					}
				}
			}
			Info_node[id173] occurrences matches {0..1} matches {	-- Maximum number of administrations
				value matches {
					Count[id188] matches {
						magnitude matches {|>=1|}
					}
				}
			}
			Info_node[id178] occurrences matches {0..1} matches {	-- Review criterion
				value matches {
					Quantity[id189] 
					Count[id190] 
					Text[id191] 
				}
			}
			Info_node[id179] occurrences matches {0..1} matches {	-- Order start date/time
				value matches {
					Date_time_value[id192] 
				}
			}
			Info_node[id180] occurrences matches {0..1} matches {	-- Order stop date/time
				value matches {
					Date_time_value[id193] 
				}
			}
			Info_node[id91] occurrences matches {0..1}  matches {
				value matches {
					Timing[id1091]
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["ac1"] = <
				text = <"Direction duration">
				description = <"The length of time for which this direction should be applied.">
			>
			["at67"] = <
				text = <"Indefinite">
				description = <"The direction should be continued indefinitely.">
			>
			["at68"] = <
				text = <"Indefinite - not to be discontinued">
				description = <"The direction should be continued indefinitely with a strong recommendation that it never be discontinued.">
			>
			["id1"] = <
				text = <"Therapeutic direction">
				description = <"Structured details of a single therapeutic direction for an ordered item, such as a medication or blood transfusion order.">
			>
			["id173"] = <
				text = <"Maximum number of administrations">
				description = <"The maximum number of administrations to be given for this direction.">
			>
			["id177"] = <
				text = <"Dosage">
				description = <"The combination of a medication dose and administration timing for a single day.">
			>
			["id178"] = <
				text = <"Review criterion">
				description = <"After a number of administrations for when a review is required.">
			>
			["id179"] = <
				text = <"Order start date/time">
				description = <"The date and optional time to commence the administration.">
			>
			["id180"] = <
				text = <"Order stop date/time">
				description = <"The date and optional time when it is planned to cease the administration.">
			>
			["id58"] = <
				text = <"Direction sequence">
				description = <"The intended position of this direction within the overall sequence of directions.">
			>
			["id67"] = <
				text = <"Direction duration">
				description = <"The length of time for which this direction should be applied.">
			>
			["id91"] = <
				text = <"Repetition timing">
				description = <"Structured details about pattern of repetition for each set of daily directions.">
			>
		>
	>
