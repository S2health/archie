	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"To record details about the processing of a specimen collected from, or related to, an individual for further analysis, preservation or storage.">
			use = <"To record details about the processing or preparation of a specimen for analysis, preservation or storage, including specific processes such as fixation, smearing, paraffin embedding, centrifuging, washing, sectioning, acidification, incubation and staining.
            
            The terms 'preparation' and 'processing' are sometimes used interchangeably and sometimes to describe specific steps performed on the specimen between collection and analysis. This archetype is intended to be used to describe all the relevant steps performed, but for simplicity uses the term 'processing' to cover both.
            
            The archetype has been designed to be nested within the Info_node.specimen archetype and to record the details about a single process step OR a multistep process. If there is only one process or step, then use the data Info_nodes at root level. If there is a multistep process, each separate step can be represented using a separate instance of the 'Process activity' internal Info_node which contains one instance of this same Info_node.specimen_processing for each process step.">
			keywords = <"specimen", "laboratory", "sample", "histopathology", "histology", "pathology", "cytology", "filtration", "centrifugation", "staining", "fixation", "dehydration", "embedding", "slicing", "pre-analytics", "FFPE", "freezing", "DNA", "extraction", "PCR", "histochemistry", "immunohistochemistry", "FISH", "incubation", "scanning", "WSI", "homogenization">
			misuse = <"Not to be used to represent specimen transportation - use Info_node.transportation for this purpose. 
            Not to be used to represent specimen storage - use EVALUATION.specimen_summary for this purpose.">
		>
	>
	other_contributors = <"openEHR CKM community">

definition
	Info_node[id1] matches {	-- Specimen processing
		items matches {
			Info_node[id95] occurrences matches {0..1} matches {	-- Process name
				value matches {
					Text[id99] 
				}
			}
			Info_node[id90] occurrences matches {0..1} matches {	-- Description
				value matches {
					Text[id100] 
				}
			}
			Info_node[id75] occurrences matches {0..1} matches {	-- Method
				value matches {
					Text[id101] 
				}
			}
			Info_node[id97] occurrences matches {0..1} matches {	-- Start date/time
				value matches {
					Date_time_value[id102] 
				}
			}
			Info_node[id98] occurrences matches {0..1} matches {	-- End date/time
				value matches {
					Date_time_value[id103] 
				}
			}
			Info_node[id92] matches {	-- Additive
				value matches {
					Text[id104] 
				}
			}
			use_archetype Entity_ref_node[id89, s2-EHR-Entity_ref_node.device_ref.v1] 
			Info_node[id87] matches {	-- Process activity
				items matches {
					Info_node[id72] occurrences matches {0..1} matches {	-- Sequence
						value matches {
							Text[id105] 
							Count[id106] 
						}
					}
					use_archetype Info_node[id93, s2-EHR-Info_node.specimen_processing.v1] occurrences matches {0..1} 
				}
			}
			Info_node[id96] occurrences matches {0..1} matches {	-- Comment
				value matches {
					Text[id107] 
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
