archetype (adl_version=2.1.0; rm_release=0.8.7)
	s2-EHR-Entity_ref_node.organization_ref.v1.0.0

specialize
	s2-EHR-Entity_ref_node.party_ref.v1

language
	original_language = <[iso_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"Thomas Beale <thomas.beale@S2health.org>">
		["organisation"] = <"S2 Health <http://www.S2health.org>">
	>
	custodian_namespace = <"org.s2health">
	custodian_organisation = <"S2 Health <http://graphitehealth.io>">
	copyright = <"Copyright (c) 2024 S2 Health">
	licence = <"Creative Commons CC-BY 4.0 unported <http://creativecommons.org/>">
	ip_acknowledgements = <
		["loinc"] = <"This content from LOINC® is copyright © 1995 Regenstrief Institute, Inc. and the LOINC Committee, and available at no cost under the license at <http://loinc.org/terms-of-use>">
		["snomed"] = <"Content from SNOMED CT® is copyright © 2007 IHTSDO <ihtsdo.org>">
	>
	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"Reference to an organization instance">
			use = <"Use to refer to an organization.">
			keywords = <"demographics", "organization">
		>
	>

definition
	Entity_ref_node[id1.1] matches {	-- Organization ref
		items matches {
			Info_node[id0.2] occurrences matches {0..1} matches {	-- Name
				value matches {
					Plain_text[id0.102] 
				}
			}
			Info_node[id0.4] occurrences matches {0..1} matches {	-- Identifier
				value matches {
					Rwe_id_ref[id0.104] 
				}
			}
			use_archetype Info_node[id0.3, s2-ENTITY-Info_node.location_address.v1] 
			use_archetype Info_node[id0.5, s2-ENTITY-Info_node.comms_address.v1] 
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Organization ref">
				description = <"Reference to an organization">
			>
			["id0.2"] = <
				text = <"Name">
				description = <"The unstructured name for the Organization.">
			>
			["id0.3"] = <
				text = <"Physical address">
				description = <"Unstructured physical address.">
			>
			["id0.4"] = <
				text = <"Identifier">
				description = <"Identifier associated with the organization.">
			>
			["id0.5"] = <
				text = <"Comms address">
				description = <"-">
			>
		>
	>
	term_bindings = <
		["loinc"] = <
			["id0.2"] = <http://loinc.org/76469-6>
			["id0.3"] = <http://loinc.org/90052-2>
			["id0.4"] = <http://loinc.org/76468-8>
			["id0.5"] = <http://loinc.org/90054-8>
			["id1.1"] = <http://loinc.org/90055-5>
		>
	>

