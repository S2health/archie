	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record details about a physical sample collected from, or related to, an individual for the purpose of investigation, examination or analysis.">
			use = <"Use to record details about a physical sample collected from, or related to, an individual for the purpose of investigation, examination or analysis.
            
            This archetype has been specifically designed to be used in the following use cases:
            - within INSTRUCTION.service_request or another laboratory-related INSTRUCTION archetype to describe a specimen that is to be collected, or to describe a specimen that accompanies a laboratory service request; 
            - within a laboratory-related ACTION archetype to describe specimen collection or a specimen that has been collected; or
            - within OBSERVATION.laboratory_test_result or other laboratory reporting OBSERVATION archetypes to describe the specimen being reported.
            In addition this archetype can also be nested within other ENTRY or Info_node archetypes, where clinically appropriate.
            
            The level of detail in this archetype is likely to exceed that currently collected in most laboratories. It has deliberately been designed to cater for a simple, single specimen collection; simultaneous collection of multiple specimens with a single request; and complex situations where it is required to record minute detail about the preparation and subdivision of a single specimen.
            
            The exact semantics of several Info_nodes of this archetype may change based on the context provided by the parent archetype in which it is nested. For example, the 'Collection method' Node in the context of an INSTRUCTION archetype is the requested collection method, while the same Node in the context of an ACTION archetype in the 'completed' state is the actual collection method.
            
            Other complementary archetypes will carry the detail about 'Specimen container', 'Specimen preparation', and 'Specimen transport'.
            
            This archetype has been designed to be used with the Specimen container archetype in two main ways: 
            - 'Specimen container' nested within 'Specimen' (for example when a venous blood specimen is divided between two vials, or a whole large intestine is divided into three buckets); or
            - 'Specimen' nested within 'Specimen container' (for example when a bucket of formalin contains a section of large intestine and a rectum, or a jar contains five individually marked moles).
            
            Please note: The term 'collection' used in this archetype always refers to the activity of obtaining a specimen from an individual. It is not intended to represent the transport of the specimen from the individual to the testing laboratory.">
			keywords = <"specimen", "laboratory", "sample", "collection", "sampling", "biopsy", "tissue", "cytology", "microbiology", "pathology", "histopathology", "histology", "lab", "fluid", "smear", "blood", "exudate", "serum", "plasma", "urine", "saliva", "secretion", "synovial", "lymph", "feces", "faeces", "fæces", "ascites", "expectorate", "swab", "breast milk", "pus", "drain fluid", "bone marrow", "culture", "scraping", "aspirate", "phlebotomy", "test", "cerebrospinal fluid", "pleural fluid", "resection", "excision">
			misuse = <"Not intended to be used for recording information about specimens that are not related to a specific individual. For example routine water samples from a waterworks, or spot samples from food production facilities.">
		>
	>
	other_contributors = <"openEHR CKM community">

definition
	Info_node[id1] matches {	-- Specimen
		items matches {
			Info_node[id30] occurrences matches {0..1} matches {	-- Specimen type
				value matches {
					Coded_text[id202] matches {
						term matches {
							Terminology_term[id203] matches {
								concept matches {[ac3]}
							}
						}
					}
				}
			}
			Info_node[id99] occurrences matches {0..1} matches {	-- Specimen label
				value matches {
					Plain_text[id103] 
				}
			}
			Info_node[id98] occurrences matches {0..1} matches {	-- Specimen description
				value matches {
					Plain_text[id104] 
				}
			}
			Info_node[id100] occurrences matches {0..1} matches {	-- Number of fragments
				value matches {
					Count[id105] 
				}
			}
			Info_node[id2] occurrences matches {0..1} matches {	-- Laboratory specimen identifier
				value matches {
					Rwe_id_ref[id106] 
				}
			}
			Info_node[id89] matches {	-- External identifier
				value matches {
					Rwe_id_ref[id108] 
				}
			}
			Info_node[id35] occurrences matches {0..1} matches {	-- Date/time received
				value matches {
					Date_time_value[id110] 
				}
			}
			Info_node[id9] matches {	-- Sampling context
				value matches {
					Text[id111] 
				}
			}
			allow_archetype Info_node[id28] matches {	-- Physical properties
				include
					archetype_id/value matches {/s2-EHR-Info_node\.specimen_measurements(-[a-zA-Z0-9_]+)*\.v1|s2-EHR-Node\.inspection_body_fluid(-[a-zA-Z0-9_]+)*\.v0/}
			}
			Info_node[id8] occurrences matches {0..1} matches {	-- Collection method
				value matches {
					Coded_text[id112] 
				}
			}
			Info_node[id80] occurrences matches {0..1} matches {	-- Collection description
				value matches {
					Plain_text[id113] 
				}
			}
			use_archetype Info_node[id14, s2-EHR-Info_node.anatomical_location.v1]
			Info_node[id16] occurrences matches {0..1} matches {	-- Collection date/time
				value matches {
					Date_time_value[id115] 
					Range<Date_time_value>[id116] 
				}
			}
			Info_node[id6] matches {	-- Hazard warning
				value matches {
					Plain_text[id117] 
				}
			}
			Info_node[id68] occurrences matches {0..1} matches {	-- Collection setting
				value matches {
					Coded_text[id118] 
				}
			}
			Info_node[id71] occurrences matches {0..1} matches {	-- Specimen collector identifier
				value matches {
					Rwe_id_ref[id119] 
				}
			}
			use_archetype Entity_ref_node[id72, s2-EHR-Entity_ref_node.party_ref.v1] occurrences matches {0..1} 
			Info_node[id81] occurrences matches {0..1} matches {	-- Number of containers
				value matches {
					Count[id121] matches {
						magnitude matches {|>=0|}
					}
				}
			}
			use_archetype Info_node[id86, s2-EHR-Info_node.specimen_container.v1] 
			use_archetype Info_node[id69, s2-EHR-Info_node.specimen_processing.v1] occurrences matches {0..1} 
			use_archetype Info_node[id94, s2-EHR-Info_node.specimen_transport.v1] occurrences matches {0..1} 
			use_archetype Info_node[id97, s2-EHR-Info_node.media_file.v2] 
			Info_node[id4] matches {	-- Parent specimen identifier
				value matches {
					Rwe_id_ref[id122] 
				}
			}
			Info_node[id43] matches {	-- Specimen quality issue
				value matches {
					Coded_text[id124] matches {
						term matches {
							Terminology_term[id129] matches {
								concept matches {[ac1]}		-- Specimen quality issue (synthesised)
							}
						}
					}
					Plain_text[id125] 
				}
			}
			Info_node[id42] occurrences matches {0..1} matches {	-- Adequacy for testing
				value matches {
					Coded_text[id126] matches {
						term matches {
							Terminology_term[id130] matches {
								concept matches {[ac2]}		-- Adequacy for testing (synthesised)
							}
						}
					}
					Plain_text[id127] 
				}
			}
			Info_node[id46] occurrences matches {0..1} matches {	-- Comment
				value matches {
					Text[id128] 
				}
			}
		}
	}

