archetype (adl_version=2.1.0; rm_release=0.8.7; uid=a53c9403-5bb9-4eab-9f37-dc030c0c011a)
	s2-EHR-Info_node.specimen.v1.2.0

language
	original_language = <[ISO_639-1::en]>

description
	lifecycle_state = <"unmanaged">
