				description = <"Details about the exertion of the person at the time of temperature measurement.">
			>
			["id60"] = <
				text = <"Device">
				description = <"Details about the device used to measure body temperature.">
			>
			["id64"] = <
				text = <"Comment">
				description = <"Additional comment about the body temperature measurement not captured in other fields.">
			>
			["id66"] = <
				text = <"Day of menstrual cycle">
				description = <"Current day of the menstrual cycle.">
			>
			["id67"] = <
				text = <"Associated Situation">
				description = <"Other potentially relevant patient-specific events that may affect interpretation, including pre- or post- operation, first sample, level of anxiety or 'white coat syndrome'; pain or fever etc.">
			>
			["id8000"] = <
				text = <"Subject">
				description = <"Subject of observation.">
			>
		>
