	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the length of the body from crown of head to sole of foot of an individual - either measured or approximated, and either in a standing or recumbent position.">
			use = <"To be used for recording the measured height or body length of an individual at any point in time.  A statement identifying the physical incompleteness of the body can be recorded in the 'Confounding factors' protocol Node, if required.  This is the usual archetype to be used for a typical measurement of height or body length, independent of the clinical setting.
            
            Can also be used for recording an approximation of height or body length measurement in a clinical scenario where it is not possible to measure an accurate height or length - for example, measuring an uncooperative child.  This is not modelled explicitly in the archetype as the openEHR Reference model allows approximations  for any Quantity data type by setting the attribute Magnitude_status to the value '~'.  At implementation, for example, an application user interface could allow clinicians to select an appropriately labelled check box adjacent to the Height data field to indicate that the recorded height is an approximation, rather than actual.
            
            In general, length measurements are recommended for children under 2 years of age and individuals who cannot stand; height measurements for all others.
            
            When recording the first length of an infant shortly after birth, \\\"birth length\\\", use the event \\\"Birth\\\".
            
            Use to record growth or loss of height.  This can currently be modelled by constraining the 'any event' to an interval event within a template, with the associated mathematical function of increase or decrease, as appropriate.">
			keywords = <"shrinkage", "increase", "decrease", "height loss", "height", "length", "growth">
			misuse = <"Not to be used to record an adjusted height, a calculation of the full height of a person who for example are missing parts or all of the lower limbs, or has contractures. A calculated body weight may be based on measurements of other body parts and an algorithm. Use specific archetypes for this purpose.
            
            Not to be used to record growth velocity.
            
            Not to be used to record the length of an object or specific body part.">
		>
	>
	other_contributors = <"openEHR CKM community", ...>

definition
	Direct_observation[id1] matches {	-- Height/Length
		data cardinality matches {1..*; unordered} matches {
			Info_node[id5] matches {	-- Height/Length
				value matches {
					Measured<Quantity>[id36] matches {
						value matches {
							Quantity[id30] matches {
								magnitude matches {|0.0..1000.0|}
								units matches {
									Coded_text[id32] matches {
										term matches {
											Terminology_term[id31] matches {
												concept matches {[at22]}
											}
										}
									}
								}
							}
						}
					}
				}
				original_value matches {
					Measured<Quantity>[id37] matches {
						value matches {
							Quantity[id33] matches {
								magnitude matches {|0.0..250.0|}
								units matches {
									Coded_text[id35] matches {
										term matches {
											Terminology_term[id34] matches {
												concept matches {[at23]}
											}
										}
									}
								}
							}
						}
					}
				}
			}
			Info_node[id19] occurrences matches {0..1} matches {	-- Comment
				value matches {
					Text[id25] 
				}
			}
		}
		state matches {
			Info_node[id15] occurrences matches {0..1} matches {	-- Position
				value matches {
					Coded_text[id26] matches {
						term matches {
							Terminology_term[id38] matches {
								concept matches {[ac1; at16]}		-- Position (synthesised)
							}
						}
					}
				}
			}
			Info_node[id20] occurrences matches {0..1} matches {	-- Confounding factors
				value matches {
					Text[id27] 
				}
			}
		}
		qualifiers matches {
			use_archetype Entity_ref_node[id12, s2-EHR-Entity_ref_node.device_ref.v1] occurrences matches {0..1} 
			Info_node[id40] occurrences matches {0..1} matches {	-- Method
				value matches {
					Coded_text[id46] matches {
						term matches {
							Terminology_term[id48] matches {
								concept matches {[ac2]}		-- Height determination method
							}
						}
					}
				}
			}
		}
		data_series matches {
			Point_event[id22] occurrences matches {0..1} matches {	-- Birth
				items matches {
					use_node Info_node[id5] /data[id5]	-- /data[Height/Length]
					use_node Info_node[id19] /data[id19]	-- /data[Comment]
				}
			}
		}
		state_series matches {
			Point_event[id22] occurrences matches {0..1} matches {	-- Birth
				items matches {
					use_node Info_node[id15] /state[id15]	-- /state[Position]
					use_node Info_node[id20] /state[id20]	-- /state[Confounding factors]
				}
			}
		}
		subject matches {
			use_archetype Entity_ref_node[id8000, s2-EHR-Entity_ref_node.party_ref.v1] 
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["ac1"] = <
				text = <"Position (synthesised)">
				description = <"Position of individual when measured. (synthesised)">
			>
			["ac2"] = <
				text = <"Height determination method">
				description = <"Height determination method">
			>
			["at16"] = <
				text = <"Standing">
				description = <"Height is measured standing on both feet with weight distributed evenly, heels together and both buttocks and heels in contact with a vertical back board.">
			>
			["at20"] = <
				text = <"Lying">
				description = <"Length is measured in a fully extended, recumbent position with the pelvis flat, legs extended and feet flexed.">
			>
			["at21"] = <
				text = <"Length">
				description = <"Length">
			>
			["at22"] = <
				text = <"cm">
				description = <"Centimetres length unit">
			>
			["at23"] = <
				text = <"in_i">
				description = <"Inches length unit">
			>
			["id1"] = <
				text = <"Height/Length">
				description = <"Height, or body length, is measured from crown of head to sole of foot.">
			>
			["id12"] = <
