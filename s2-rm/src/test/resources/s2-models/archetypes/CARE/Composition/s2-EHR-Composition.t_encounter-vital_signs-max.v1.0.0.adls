template (adl_version=2.1.0; rm_release=0.8.7)
	s2-EHR-Composition.t_encounter-vital_signs-max.v1.0.0

specialize
	s2-EHR-Composition.encounter.v1

language
	original_language = <[iso_639-1::en]>

description
	lifecycle_state = <"unmanaged">
	original_author = <
		["name"] = <"Thomas Beale <thomas.beale@GraphiteHealth.io>">
		["organisation"] = <"Graphite Health <http://www.GraphiteHealth.io>">
	>
	custodian_namespace = <"org.s2health">
	custodian_organisation = <"S2 Health <http://s2health.org>">
	copyright = <"Copyright (c) 2024 S2 Health">
	licence = <"Creative Commons CC-BY 4.0 unported <http://creativecommons.org/>">
	details = <
		["en"] = <
			language = <[iso_639-1::en]>
			purpose = <"Vital Signs Panel, maximal form">
		>
	>

definition
	Composition[id1.1] matches {	-- Vital signs panel
		content matches {
			use_archetype Direct_observation[id0.1, s2-EHR-Direct_observation.t_vital_signs-max-bp.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.2, s2-EHR-Direct_observation.t_vital_signs-max-hr.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.3, s2-EHR-Direct_observation.t_vital_signs-max-weight.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.4, s2-EHR-Direct_observation.t_vital_signs-max-height.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.5, s2-EHR-Direct_observation.t_vital_signs-max-body_mass_index.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.6, s2-EHR-Direct_observation.t_vital_signs-max-pulse_ox.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.7, s2-EHR-Direct_observation.t_vital_signs-max-body_temperature.v1] occurrences matches {0..1} 
			use_archetype Direct_observation[id0.8, s2-EHR-Direct_observation.t_vital_signs-max-respiratory_rate.v1] occurrences matches {0..1} 
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"Vital signs panel">
				description = <"Set of vital signs and other basic observations">
			>
			["id0.1"] = <
				text = <"Blood pressure">
				description = <"Vital signs BP observation">
			>
			["id0.2"] = <
				text = <"Heart rate">
				description = <"Vital signs heart rate observation">
			>
			["id0.3"] = <
				text = <"Body weight">
				description = <"Vital signs body weight observation">
			>
			["id0.4"] = <
				text = <"Height">
				description = <"Vital signs height observation">
			>
			["id0.5"] = <
				text = <"BMI">
				description = <"Vital signs BMI observation">
			>
			["id0.6"] = <
				text = <"Pulse oximetry">
				description = <"Vital signs pulse oximetry observation">
			>
			["id0.7"] = <
				text = <"Body Temperature">
				description = <"Vital signs body temperature observation">
			>
			["id0.8"] = <
				text = <"Respiratory Rate">
				description = <"Vital signs respiratory rate observation">
			>
		>
	>
	term_bindings = <
		["loinc"] = <
			["id1.1"] = <http://loinc.org/85353-1>
		>
	>

-------------------------------------------------------------
template_overlay
	s2-EHR-Direct_observation.t_vital_signs-max-bp.v1.0.0

specialize
	s2-EHR-Direct_observation.blood_pressure.v3

definition
	Direct_observation[id1.1] matches {	-- BP as used in vital signs panel
		data_series existence matches {0} 
		state_series existence matches {0} 
	}

terminology
	term_definitions = <
		["en"] = <
			["id1.1"] = <
				text = <"BP as used in vital signs panel">
				description = <"BP as used in vital signs panel">
			>
		>
	>

